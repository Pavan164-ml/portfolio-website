---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechStack from '../components/TechStack.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { projects } from '../data/projects.ts';

const featuredProjects = projects.filter(p => p.featured);
const otherProjects = projects.filter(p => !p.featured);

const skills = [
  {
    category: "Agentic AI & LLMs",
    items: ["LangChain", "LangGraph", "Ollama", "Phi-3/Llama", "RAG", "ChromaDB", "FAISS", "Function Calling", "Multi-Agent Systems", "Agent Orchestration"]
  },
  {
    category: "Data Engineering",
    items: ["PySpark", "Delta Lake", "DuckDB", "Airflow", "Medallion Arch", "Star Schema", "dbt", "Parquet", "Data Quality", "Incremental Loads"]
  },
  {
    category: "Cloud & DevOps",
    items: ["AWS", "Lambda", "Bedrock", "S3", "DynamoDB", "Docker", "GitHub Actions", "Serverless", "Terraform", "CI/CD"]
  },
  {
    category: "GenAI Applications",
    items: ["Gemini", "Claude", "Bedrock", "Document AI", "Chatbots", "Streaming", "Extraction", "Validation", "Structured Output", "Prompt Engineering"]
  }
];
---

<Layout title="Pavan Kumar — AI Data Engineer">
  <Hero
    title="AI Data Engineer"
    subtitle="Building agentic solutions that transform how enterprises work with data. From Deloitte to Infocepts — architecting end-to-end AI platforms with multi-agent systems, vector databases, and local LLM deployments."
    ctaText="View Projects"
    ctaHref="/projects"
    secondaryCtaText="Get In Touch"
    secondaryCtaHref="/contact"
  />

  <section class="section expertise-section" id="expertise">
    <div class="container">
      <ScrollReveal delay={0} class="section-header">
        <h2>Technical Expertise</h2>
        <p>Technologies and frameworks I use to build production-grade AI systems</p>
      </ScrollReveal>
      
      <ScrollReveal delay={100}>
        <TechStack skills={skills} />
      </ScrollReveal>
    </div>
  </section>

  <section class="section featured-projects" id="featured">
    <div class="container">
      <ScrollReveal delay={0} class="section-header">
        <h2>Featured Projects</h2>
        <p>Production-grade platforms showcasing agentic AI, lakehouse architecture, and serverless GenAI</p>
      </ScrollReveal>
      
      <div class="grid-responsive stagger">
        {featuredProjects.map((project, i) => (
          <ScrollReveal delay={i * 100} key={project.id}>
            <ProjectCard {...project} />
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section all-projects" id="projects-preview">
    <div class="container">
      <ScrollReveal delay={0} class="section-header">
        <h2>All Projects</h2>
        <p>Complete portfolio of data engineering, GenAI, and agentic solutions</p>
      </ScrollReveal>
      
      <div class="grid-responsive stagger">
        {otherProjects.map((project, i) => (
          <ScrollReveal delay={i * 100} key={project.id}>
            <ProjectCard {...project} />
          </ScrollReveal>
        ))}
      </div>
      
      <ScrollReveal delay={300} class="text-center mt-4">
        <a href="/projects" class="btn btn-secondary">View All Projects →</a>
      </ScrollReveal>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <ScrollReveal class="cta-card card highlight-card">
        <h2>Ready to Build Something?</h2>
        <p>I'm currently at Infocepts building the next generation of AI-powered data platforms. Let's connect if you're working on agentic solutions, lakehouse architectures, or GenAI applications.</p>
        <a href="/contact" class="btn btn-primary mt-2">Start a Conversation</a>
      </ScrollReveal>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 6rem 0;
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .section-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  
  .section-header p {
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .expertise-section {
    background: linear-gradient(180deg, var(--background) 0%, var(--surface) 100%);
    position: relative;
  }
  
  .expertise-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(139, 155, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  
  .expertise-section .container {
    position: relative;
    z-index: 1;
  }
  
  .featured-projects {
    background: var(--background);
  }
  
  .all-projects {
    background: var(--surface);
  }
  
  .cta-section {
    padding: 8rem 0;
  }
  
  .cta-card {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }
  
  .cta-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
  }
  
  .cta-card h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1rem;
  }
  
  .cta-card p {
    font-size: 1.125rem;
    color: var(--muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  
  .mt-2 {
    margin-top: 1rem;
  }
  
  .mt-4 {
    margin-top: 1.5rem;
  }
  
  .text-center {
    text-align: center;
  }
  
  .stagger > * {
    opacity: 0;
    transform: translateY(30px);
  }
  
  .stagger.is-visible > * {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  
  .stagger.is-visible > *:nth-child(1) { transition-delay: 0ms; }
  .stagger.is-visible > *:nth-child(2) { transition-delay: 100ms; }
  .stagger.is-visible > *:nth-child(3) { transition-delay: 200ms; }
  .stagger.is-visible > *:nth-child(4) { transition-delay: 300ms; }
  .stagger.is-visible > *:nth-child(5) { transition-delay: 400ms; }
  .stagger.is-visible > *:nth-child(6) { transition-delay: 500ms; }
  
  @media (max-width: 768px) {
    .section {
      padding: 4rem 0;
    }
  }
</style>