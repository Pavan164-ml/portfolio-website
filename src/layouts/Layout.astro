---
import '../styles/tailwind.css';
import '../styles/globals.css';
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Pavan Kumar — AI Data Engineer building agentic solutions, lakehouse platforms, and GenAI applications. Former Deloitte, now at Infocepts." />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <meta property="og:title" content={title} />
  <meta property="og:description" content="AI Data Engineer portfolio — Agentic AI, Lakehouse Platforms, GenAI Applications" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content="AI Data Engineer portfolio — Agentic AI, Lakehouse Platforms, GenAI Applications" />
</head>
<body>
  <header class="site-header">
    <nav class="nav container">
      <a href="/" class="nav-logo" aria-label="Home">
        <svg viewBox="0 0 32 32" fill="none" width="32" height="32" class="logo-icon">
          <rect width="32" height="32" rx="8" fill="url(#grad)" />
          <path d="M10 16L14 20L22 12" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <defs>
            <linearGradient id="grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#8B9BFF" />
              <stop offset="100%" stop-color="#A78BFA" />
            </linearGradient>
          </defs>
        </svg>
        <span class="logo-text">PK</span>
      </a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <p class="copyright">&copy; {new Date().getFullYear()} Pavan Kumar. Built with Astro & Tailwind.</p>
        <div class="footer-links">
          <a href="https://github.com/Pavan164-ml" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
          <a href="https://linkedin.com/in/pavan-kumar-206088189" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="mailto:pavan.kumar@example.com" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav toggle
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    
    if (navToggle && navLinks) {
      navToggle.addEventListener('click', () => {
        const expanded = navToggle.getAttribute('aria-expanded') === 'true';
        navToggle.setAttribute('aria-expanded', (!expanded).toString());
        navLinks.classList.toggle('nav-links--open');
      });
    }
    
    // Active nav link highlighting
    const currentPath = window.location.pathname;
    document.querySelectorAll('.nav-links a').forEach(link => {
      if (link.getAttribute('href') === currentPath || 
          (currentPath !== '/' && link.getAttribute('href') !== '/' && currentPath.startsWith(link.getAttribute('href')))) {
        link.classList.add('nav-link--active');
      }
    });
  </script>

  <style>
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(11, 16, 32, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      z-index: 100;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      color: var(--foreground);
      font-weight: 700;
      font-size: 1.125rem;
    }

    .nav-logo:hover {
      text-decoration: none;
    }

    .logo-icon {
      flex-shrink: 0;
    }

    .logo-text {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-links a {
      color: var(--muted);
      font-weight: 500;
      font-size: 0.9375rem;
      transition: color 0.2s;
      position: relative;
    }

    .nav-links a:hover,
    .nav-links a.nav-link--active {
      color: var(--foreground);
    }

    .nav-links a.nav-link--active::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 1px;
    }

    .nav-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--foreground);
      cursor: pointer;
      padding: 0.5rem;
    }

    .site-footer {
      background: var(--surface);
      border-top: 1px solid var(--border);
      padding: 2rem 0;
      margin-top: auto;
    }

    .footer-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .copyright {
      color: var(--muted);
      font-size: 0.875rem;
      margin: 0;
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
    }

    .footer-links a {
      color: var(--muted);
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--primary);
    }

    @media (max-width: 768px) {
      .nav-links {
        position: fixed;
        top: 64px;
        left: 0;
        right: 0;
        background: var(--background);
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        padding: 1.5rem;
        gap: 1.5rem;
        transform: translateY(-100%);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s;
      }

      .nav-links.nav-links--open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }

      .nav-toggle {
        display: block;
      }

      .footer-content {
        flex-direction: column;
        text-align: center;
      }
    }
  </style>

  <script>
    function initScrollReveal(element) {
      const delay = parseInt(element.dataset.delay || '0', 10);
      const duration = parseInt(element.dataset.duration || '800', 10);
      const easing = element.dataset.easing || 'ease-out';
      const threshold = parseFloat(element.dataset.threshold || '0.1');
      const rootMargin = element.dataset.rootMargin || '0px 0px -50px 0px';
      const once = element.dataset.once !== 'false';

      element.style.setProperty('--duration', duration + 'ms');
      element.style.setProperty('--easing', easing);
      element.style.setProperty('--delay', delay + 'ms');

      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            if (once) {
              observer.unobserve(entry.target);
            }
          } else if (!once) {
            entry.target.classList.remove('is-visible');
          }
        });
      }, { threshold: threshold, rootMargin: rootMargin });

      observer.observe(element);
    }

    function initAllScrollReveal() {
      document.querySelectorAll('.scroll-reveal:not([data-initialized])').forEach(function(el) {
        el.setAttribute('data-initialized', 'true');
        initScrollReveal(el);
      });
    }

    document.addEventListener('DOMContentLoaded', initAllScrollReveal);
    document.addEventListener('astro:after-swap', initAllScrollReveal);
  </script>

  <script>
    function initTechOrbs() {
      document.querySelectorAll('.tech-orb').forEach(function(orb) {
        orb.addEventListener('mousemove', function(e) {
          const rect = orb.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;

          orb.style.transform = 'scale(1.05) translate(' + (x * 0.1) + 'px, ' + (y * 0.1) + 'px) translateY(-2px)';
        });

        orb.addEventListener('mouseleave', function() {
          orb.style.transform = '';
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initTechOrbs);
    document.addEventListener('astro:after-swap', initTechOrbs);
  </script>
</body>
</html>