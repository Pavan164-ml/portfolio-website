---
import NeuralBackground from './NeuralBackground.astro';
import Typewriter from './Typewriter.astro';
import AnimatedCounter from './AnimatedCounter.astro';
import ScrollReveal from './ScrollReveal.astro';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  videoSrc?: string;
  videoPoster?: string;
}

const {
  title = "AI Data Engineer",
  subtitle = "Building agentic solutions that transform how enterprises work with data. From Deloitte to Infocepts — architecting end-to-end AI platforms.",
  ctaText = "View Projects",
  ctaHref = "/projects",
  secondaryCtaText = "Get In Touch",
  secondaryCtaHref = "/contact",
  videoSrc,
  videoPoster
} = Astro.props;
---

<section class="hero" id="home">
  <NeuralBackground class="hero-neural" numNodes={80} connectionDistance={180} opacity={0.15} />
  
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <ScrollReveal delay={0} class="hero-badge-wrapper">
          <span class="hero-badge">AI Data Engineer • Agentic Solutions</span>
        </ScrollReveal>
        
        <ScrollReveal delay={100} class="hero-title-wrapper">
          <h1 class="hero-title">
            <Typewriter 
              texts={["AI Data Engineer", "Agentic Solutions Architect", "Lakehouse Platform Builder", "GenAI Application Developer"]}
              speed={80}
              deleteSpeed={40}
              pauseTime={2500}
            />
          </h1>
        </ScrollReveal>
        
        <ScrollReveal delay={200} class="hero-subtitle-wrapper">
          <p class="hero-subtitle">{subtitle}</p>
        </ScrollReveal>
        
        <ScrollReveal delay={300} class="hero-ctas-wrapper">
          <div class="hero-ctas">
            <a href={ctaHref} class="btn btn-primary btn-glow">
              <span>{ctaText}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a href={secondaryCtaHref} class="btn btn-secondary">
              <span>{secondaryCtaText}</span>
            </a>
          </div>
        </ScrollReveal>
        
        <ScrollReveal delay={400} class="hero-stats-wrapper">
          <div class="hero-stats stagger">
            <AnimatedCounter value={15} suffix="+" label="Agentic Solutions" duration={1800} />
            <AnimatedCounter value={4} suffix="" label="Production Platforms" duration={2000} />
            <AnimatedCounter value={15} suffix="M+" label="Records Processed" duration={2200} />
            <AnimatedCounter value={3} suffix="" label="Fortune 500 Clients" duration={2400} />
          </div>
        </ScrollReveal>
      </div>
      
      <ScrollReveal delay={500} class="hero-visual-wrapper">
        <div class="hero-visual">
          {videoSrc ? (
            <div class="hero-video">
              <div class="video-container">
                <video
                  class="hero-video-player"
                  poster={videoPoster}
                  preload="metadata"
                  playsinline
                  muted
                  loop
                >
                  <source src={videoSrc} type="video/mp4" />
                </video>
                <div class="video-overlay">
                  <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor" width="64" height="64">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  <p>Watch Agentic Demo</p>
                </div>
              </div>
            </div>
          ) : (
            <div class="hero-architecture" aria-hidden="true"></div>
          )}
        </div>
      </ScrollReveal>
    </div>
  </div>
  
  <div class="hero-scroll-indicator">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24" aria-hidden="true">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
    position: relative;
    overflow: hidden;
  }
  
  .hero-neural {
    z-index: 0;
  }
  
  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  
  @media (max-width: 968px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }
  }
  
  .hero-badge-wrapper {
    display: inline-block;
  }
  
  .hero-badge {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: var(--background);
    border-radius: 2rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    box-shadow: 0 4px 20px rgba(139, 155, 255, 0.3);
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  
  .hero-title .typewriter {
    display: block;
  }
  
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 2rem;
    max-width: 550px;
  }
  
  @media (max-width: 968px) {
    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
  }
  
  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }
  
  @media (max-width: 968px) {
    .hero-ctas {
      justify-content: center;
    }
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: none;
    text-decoration: none;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent), var(--primary));
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
    color: var(--background);
    box-shadow: 0 4px 20px rgba(139, 155, 255, 0.4);
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(139, 155, 255, 0.5);
  }
  
  .btn-primary:hover::before {
    opacity: 1;
  }
  
  .btn-primary span,
  .btn-primary svg {
    position: relative;
    z-index: 1;
  }
  
  .btn-secondary {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--foreground);
  }
  
  .btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(139, 155, 255, 0.2);
  }
  
  .btn-glow {
    animation: pulseGlow 3s ease-in-out infinite;
  }
  
  @keyframes pulseGlow {
    0%, 100% { box-shadow: 0 4px 20px rgba(139, 155, 255, 0.4); }
    50% { box-shadow: 0 4px 30px rgba(139, 155, 255, 0.6), 0 0 40px rgba(139, 155, 255, 0.3); }
  }
  
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  
  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .hero-visual {
    position: sticky;
    top: 5rem;
    height: 100%;
  }
  
  .hero-video-player {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
  }
  
  .video-container {
    position: relative;
    max-width: 100%;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
  }
  
  .video-overlay {
    cursor: pointer;
  }
  
  .video-overlay:hover {
    opacity: 0.9;
  }
  
  .play-icon {
    margin-bottom: 1rem;
    transition: transform 0.3s;
    filter: drop-shadow(0 4px 20px rgba(139, 155, 255, 0.5));
  }
  
  .video-overlay:hover .play-icon {
    transform: scale(1.15);
  }
  
  .video-overlay p {
    font-size: 1rem;
    font-weight: 500;
    opacity: 0.9;
  }
  
  .hero-architecture {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 500px;
    margin: 0 auto;
  }
  
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    opacity: 0.6;
    animation: scrollBounce 2s ease-in-out infinite;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.4; }
    50% { transform: translateX(-50%) translateY(10px); opacity: 0.8; }
  }
  
  @media (max-width: 768px) {
    .hero {
      padding: 5rem 0 3rem;
      min-height: auto;
    }
    
    .hero-stats {
      gap: 1rem;
    }
  }
</style>

<script>
  import '../scripts/architecture-diagram.js';

  // Video play/pause on click
  document.addEventListener('DOMContentLoaded', () => {
    const videoContainer = document.querySelector('.video-container');
    const video = document.querySelector('.hero-video-player');
    
    if (videoContainer && video) {
      videoContainer.addEventListener('click', () => {
        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
});
    }
  });
</script>
