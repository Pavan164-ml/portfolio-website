---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  impact?: string;
  githubUrl?: string;
  demoUrl?: string;
  image?: string;
  imageAlt?: string;
  featured?: boolean;
  category?: string;
}

const {
  title,
  description,
  techStack,
  impact,
  githubUrl,
  demoUrl,
  image,
  imageAlt,
  featured = false,
  category
} = Astro.props;
---

<article class="project-card card animate-slide-up" data-category={category}>
  {image && (
    <div class="project-image">
      <img src={image} alt={imageAlt || title} loading="lazy" />
      {featured && <span class="featured-badge">Featured</span>}
    </div>
  )}
  
  <div class="project-content">
    <header class="project-header">
      {category && <span class="project-category">{category}</span>}
      <h3 class="project-title">{title}</h3>
    </header>
    
    <p class="project-description">{description}</p>
    
    {impact && (
      <div class="project-impact">
        <svg class="impact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
        <span>{impact}</span>
      </div>
    )}
    
    <div class="project-tech">
      {techStack.map(tech => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>
    
    <div class="project-links">
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="project-link">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
          </svg>
          Code
        </a>
      )}
      {demoUrl && (
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="project-link project-link--demo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <polyline points="18 13 22 13 22 17" />
            <path d="M6 9l12-6" />
            <polyline points="6 17 2 17 2 11" />
            <path d="M18 15l-6 6" />
          </svg>
          Demo
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    position: relative;
  }

  .project-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
    background: var(--border);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .featured-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    background: var(--accent);
    color: var(--background);
    border-radius: 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .project-category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
  }

  .project-description {
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }

  .project-impact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(139, 155, 255, 0.1);
    border-radius: 0.5rem;
    border: 1px solid rgba(139, 155, 255, 0.2);
  }

  .impact-icon {
    color: var(--primary);
    flex-shrink: 0;
  }

  .project-impact span {
    font-size: 0.875rem;
    color: var(--foreground);
    font-weight: 500;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    padding: 0.375rem 0.75rem;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    transition: all 0.2s;
  }

  .tech-tag:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    border: 1px solid var(--primary);
    transition: all 0.2s;
  }

  .project-link:hover {
    background: var(--primary);
    color: var(--background);
    text-decoration: none;
  }

  .project-link--demo {
    color: var(--foreground);
    border-color: var(--border);
  }

  .project-link--demo:hover {
    background: var(--surface);
    border-color: var(--primary);
    color: var(--primary);
  }
</style>