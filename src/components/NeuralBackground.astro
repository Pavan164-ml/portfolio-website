---
interface Props {
  class?: string;
  numNodes?: number;
  connectionDistance?: number;
  color?: string;
  opacity?: number;
}

const {
  class: className = "",
  numNodes = 60,
  connectionDistance = 150,
  color = "var(--primary)",
  opacity = 0.3
} = Astro.props;
---

<canvas 
  class={`neural-bg ${className}`}
  data-nodes={numNodes}
  data-distance={connectionDistance}
  data-color={color}
  data-opacity={opacity}
  aria-hidden="true"
></canvas>

<style>
  .neural-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  class NeuralNetwork {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    nodes: Node[];
    numNodes: number;
    connectionDistance: number;
    color: string;
    opacity: number;
    animationId: number;
    resizeObserver: ResizeObserver;
    
    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d')!;
      this.numNodes = parseInt(canvas.dataset.nodes || '60');
      this.connectionDistance = parseInt(canvas.dataset.distance || '150');
      this.color = canvas.dataset.color || 'var(--primary)';
      this.opacity = parseFloat(canvas.dataset.opacity || '0.3');
      this.nodes = [];
      this.animationId = 0;
      
      this.init();
      this.animate();
      this.setupResize();
    }
    
    init() {
      this.resize();
      this.createNodes();
    }
    
    resize() {
      const rect = this.canvas.parentElement!.getBoundingClientRect();
      this.canvas.width = rect.width * window.devicePixelRatio;
      this.canvas.height = rect.height * window.devicePixelRatio;
      this.canvas.style.width = rect.width + 'px';
      this.canvas.style.height = rect.height + 'px';
      this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    
    setupResize() {
      this.resizeObserver = new ResizeObserver(() => this.resize());
      this.resizeObserver.observe(this.canvas.parentElement!);
    }
    
    createNodes() {
      this.nodes = [];
      const width = this.canvas.width / window.devicePixelRatio;
      const height = this.canvas.height / window.devicePixelRatio;
      
      for (let i = 0; i < this.numNodes; i++) {
        this.nodes.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          radius: Math.random() * 2 + 1,
          pulse: Math.random() * Math.PI * 2,
          pulseSpeed: Math.random() * 0.02 + 0.01
        });
      }
    }
    
    getColor() {
      const computed = getComputedStyle(document.documentElement);
      const primary = computed.getPropertyValue('--primary').trim();
      return primary || '#8B9BFF';
    }
    
    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      
      const width = this.canvas.width / window.devicePixelRatio;
      const height = this.canvas.height / window.devicePixelRatio;
      
      // Update nodes
      this.nodes.forEach(node => {
        node.x += node.vx;
        node.y += node.vy;
        node.pulse += node.pulseSpeed;
        
        // Bounce off edges
        if (node.x < 0 || node.x > width) node.vx *= -1;
        if (node.y < 0 || node.y > height) node.vy *= -1;
        
        // Keep in bounds
        node.x = Math.max(0, Math.min(width, node.x));
        node.y = Math.max(0, Math.min(height, node.y));
      });
      
      // Draw connections
      this.ctx.strokeStyle = this.getColor();
      this.ctx.lineWidth = 0.5;
      
      for (let i = 0; i < this.nodes.length; i++) {
        for (let j = i + 1; j < this.nodes.length; j++) {
          const dx = this.nodes[i].x - this.nodes[j].x;
          const dy = this.nodes[i].y - this.nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          
          if (dist < this.connectionDistance) {
            const alpha = (1 - dist / this.connectionDistance) * this.opacity;
            this.ctx.globalAlpha = alpha;
            this.ctx.beginPath();
            this.ctx.moveTo(this.nodes[i].x, this.nodes[i].y);
            this.ctx.lineTo(this.nodes[j].x, this.nodes[j].y);
            this.ctx.stroke();
          }
        }
      }
      
      // Draw nodes
      this.nodes.forEach(node => {
        const pulseRadius = node.radius + Math.sin(node.pulse) * 0.5;
        this.ctx.globalAlpha = this.opacity * 0.8;
        this.ctx.fillStyle = this.getColor();
        this.ctx.beginPath();
        this.ctx.arc(node.x, node.y, pulseRadius, 0, Math.PI * 2);
        this.ctx.fill();
        
        // Core
        this.ctx.globalAlpha = this.opacity;
        this.ctx.fillStyle = '#fff';
        this.ctx.beginPath();
        this.ctx.arc(node.x, node.y, Math.max(0.5, pulseRadius * 0.3), 0, Math.PI * 2);
        this.ctx.fill();
      });
      
      this.ctx.globalAlpha = 1;
      this.animationId = requestAnimationFrame(() => this.animate());
    }
    
    destroy() {
      cancelAnimationFrame(this.animationId);
      this.resizeObserver?.disconnect();
    }
  }
  
  // Initialize when canvas is in viewport
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const canvas = entry.target as HTMLCanvasElement;
        if (!canvas.dataset.initialized) {
          canvas.dataset.initialized = 'true';
          new NeuralNetwork(canvas);
        }
      }
    });
  }, { rootMargin: '100px' });
  
  document.querySelectorAll('.neural-bg').forEach(canvas => {
    observer.observe(canvas);
  });
</script>
