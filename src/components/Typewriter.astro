---
interface Props {
  texts: string[];
  class?: string;
  speed?: number;
  deleteSpeed?: number;
  pauseTime?: number;
  cursorChar?: string;
}

const {
  texts = ["AI Data Engineer", "Agentic Solutions Architect", "Lakehouse Platform Builder", "GenAI Application Developer"],
  class: className = "",
  speed = 80,
  deleteSpeed = 40,
  pauseTime = 2000,
  cursorChar = "|"
} = Astro.props;
---

<span class={`typewriter ${className}`} data-texts={JSON.stringify(texts)} data-speed={speed} data-delete-speed={deleteSpeed} data-pause-time={pauseTime} data-cursor={cursorChar}>
  <span class="typewriter-text"></span>
  <span class="typewriter-cursor" aria-hidden="true">{cursorChar}</span>
</span>

<style>
  .typewriter {
    display: inline-flex;
    align-items: baseline;
  }
  
  .typewriter-text {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .typewriter-cursor {
    color: var(--primary);
    animation: blink 1s infinite;
    margin-left: 2px;
    font-weight: 400;
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>

<script>
  class Typewriter {
    element: HTMLElement;
    textElement: HTMLElement;
    texts: string[];
    speed: number;
    deleteSpeed: number;
    pauseTime: number;
    textIndex: number;
    charIndex: number;
    isDeleting: boolean;
    timeoutId: number;
    
    constructor(element: HTMLElement) {
      this.element = element;
      this.textElement = element.querySelector('.typewriter-text')!;
      this.texts = JSON.parse(element.dataset.texts || '[]');
      this.speed = parseInt(element.dataset.speed || '80');
      this.deleteSpeed = parseInt(element.dataset.deleteSpeed || '40');
      this.pauseTime = parseInt(element.dataset.pauseTime || '2000');
      this.textIndex = 0;
      this.charIndex = 0;
      this.isDeleting = false;
      this.timeoutId = 0;
      
      this.type();
    }
    
    type() {
      const currentText = this.texts[this.textIndex];
      
      if (this.isDeleting) {
        this.textElement.textContent = currentText.substring(0, this.charIndex - 1);
        this.charIndex--;
      } else {
        this.textElement.textContent = currentText.substring(0, this.charIndex + 1);
        this.charIndex++;
      }
      
      let typeSpeed = this.isDeleting ? this.deleteSpeed : this.speed;
      
      if (!this.isDeleting && this.charIndex === currentText.length) {
        typeSpeed = this.pauseTime;
        this.isDeleting = true;
      } else if (this.isDeleting && this.charIndex === 0) {
        this.isDeleting = false;
        this.textIndex = (this.textIndex + 1) % this.texts.length;
        typeSpeed = 500;
      }
      
      this.timeoutId = window.setTimeout(() => this.type(), typeSpeed);
    }
    
    destroy() {
      clearTimeout(this.timeoutId);
    }
  }
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const element = entry.target as HTMLElement;
        if (!element.dataset.initialized) {
          element.dataset.initialized = 'true';
          new Typewriter(element);
        }
      }
    });
  }, { rootMargin: '50px' });
  
  document.querySelectorAll('.typewriter').forEach(el => {
    observer.observe(el);
  });
</script>
